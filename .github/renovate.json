{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>sbaerlocher/.github:renovate-go#2026-07-08",
    "github>sbaerlocher/.github:renovate-js#2026-07-08",
    "github>sbaerlocher/.github:renovate-docker#2026-07-08"
  ],
  "customManagers": [
    {
      "description": "Track Savvy appVersion in Helm Chart.yaml",
      "customType": "regex",
      "managerFilePatterns": ["/^deploy/helm/Chart\\.yaml$/"],
      "matchStrings": ["appVersion: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "ghcr.io/sbaerlocher/container/savvy",
      "datasourceTemplate": "docker",
      "versioningTemplate": "semver"
    }
  ],
  "packageRules": [
    {
      "description": "Savvy image: disable digest pinning, auto-merge version updates after CI",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/sbaerlocher/container/savvy"],
      "pinDigests": false,
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "description": "Savvy image: disable Renovate for dev overlay (uses rolling 'dev' tag)",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/sbaerlocher/container/savvy"],
      "matchFileNames": ["deploy/kustomize/overlays/development/**"],
      "enabled": false
    },
    {
      "description": "cookie: pin to v1.x — SvelteKit imports parse/serialize, removed in cookie v2 (ESM-only). Override floor stays for GHSA bounds-bypass fix.",
      "matchManagers": ["npm"],
      "matchPackageNames": ["cookie"],
      "allowedVersions": "<2.0.0"
    }
  ]
}
