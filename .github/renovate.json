{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>sbaerlocher/.github:renovate-go#2026-03-22",
    "github>sbaerlocher/.github:renovate-docker#2026-03-22"
  ],
  "customManagers": [
    {
      "description": "Track Savvy appVersion in Helm Chart.yaml",
      "customType": "regex",
      "fileMatch": ["^deploy/helm/Chart\\.yaml$"],
      "matchStrings": ["appVersion: \"(?<currentValue>[^\"]+)\""],
      "depNameTemplate": "ghcr.io/sbaerlocher/container/savvy",
      "datasourceTemplate": "docker"
    }
  ],
  "packageRules": [
    {
      "description": "Savvy image: disable digest pinning, auto-merge version updates after CI",
      "matchDatasources": ["docker"],
      "matchPackageNames": ["ghcr.io/sbaerlocher/container/savvy"],
      "pinDigests": false,
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    }
  ]
}
