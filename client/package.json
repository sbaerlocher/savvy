{
	"overrides": {
		"cookie": ">=1.1.1 <2.0.0"
	},
	"dependencies": {
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"barcode-detector": "^3.2.3",
		"bwip-js": "^4.11.4"
	},
	"devDependencies": {
		"@axe-core/playwright": "4.14.0",
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.64.1",
		"@sveltejs/adapter-static": "4.0.0",
		"@sveltejs/kit": "3.1.0",
		"@sveltejs/vite-plugin-svelte": "7.3.1",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "7.0.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"@vitest/ui": "5.0.5",
		"esbuild": "0.28.2",
		"eslint": "10.13.0",
		"eslint-plugin-svelte": "3.23.1",
		"globals": "17.13.0",
		"happy-dom": "21.0.4",
		"postcss": "8.5.31",
		"prettier": "3.9.10",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.57.2",
		"svelte-check": "4.7.7",
		"svelte-eslint-parser": "1.10.0",
		"tailwindcss": "4.3.3",
		"tsx": "4.23.15",
		"typescript": "6.0.3",
		"typescript-eslint": "8.72.0",
		"vite": "8.3.5",
		"vitest": "5.0.5",
		"workbox-cacheable-response": "7.4.1",
		"workbox-expiration": "7.4.1",
		"workbox-precaching": "7.4.1",
		"workbox-recipes": "7.4.1",
		"workbox-routing": "7.4.1",
		"workbox-strategies": "7.4.1"
	},
	"name": "savvy-frontend",
	"license": "MIT",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 5173",
		"build": "svelte-kit sync && vite build",
		"build:embed": "npm run build && npm run copy:assets",
		"copy:assets": "rm -rf ../internal/assets/client && cp -r build ../internal/assets/client && echo '✅ Assets copied to internal/assets/client/'",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && tsc --noEmit -p src/service-worker",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "npm run check",
		"lint": "eslint .",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"structure": "playwright test --project=structure",
		"structure:routes": "tsx scripts/check-routes.ts",
		"structure:record": "playwright test --project=structure tests/structure/baseline.spec.ts --update-snapshots",
		"structure:axe-record": "AXE_RECORD=1 playwright test --project=structure tests/structure/axe.spec.ts",
		"postinstall": "cp node_modules/zxing-wasm/dist/reader/zxing_reader.wasm static/zxing_reader.wasm 2>/dev/null || true",
		"format": "prettier --write './**/*.{svelte,ts,js}'",
		"format:check": "prettier --check './**/*.{svelte,ts,js}'"
	},
	"type": "module",
	"version": "1.0.0",
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
