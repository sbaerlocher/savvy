{
	"overrides": {
		"cookie": ">=1.1.1 <2.0.0"
	},
	"dependencies": {
		"@fontsource-variable/instrument-sans": "^5.3.0",
		"@fontsource/ibm-plex-mono": "^5.3.0",
		"@vite-pwa/sveltekit": "^1.1.0",
		"barcode-detector": "^3.2.1",
		"bwip-js": "^4.11.2",
		"workbox-window": "^7.4.1"
	},
	"devDependencies": {
		"@eslint/js": "10.0.1",
		"@playwright/test": "1.61.1",
		"@sveltejs/adapter-static": "3.0.10",
		"@sveltejs/kit": "2.70.1",
		"@sveltejs/vite-plugin-svelte": "7.2.0",
		"@tailwindcss/vite": "4.3.3",
		"@testing-library/jest-dom": "6.9.1",
		"@testing-library/svelte": "5.4.2",
		"@types/node": "25.9.5",
		"@vitest/coverage-v8": "4.1.10",
		"@vitest/ui": "4.1.10",
		"esbuild": "0.28.1",
		"eslint": "10.7.0",
		"eslint-plugin-svelte": "3.21.0",
		"globals": "17.7.0",
		"happy-dom": "20.11.0",
		"postcss": "8.5.20",
		"prettier": "3.9.5",
		"prettier-plugin-svelte": "4.1.1",
		"svelte": "5.56.6",
		"svelte-check": "4.7.3",
		"svelte-eslint-parser": "1.8.0",
		"tailwindcss": "4.3.3",
		"tslib": "2.8.1",
		"typescript": "6.0.3",
		"typescript-eslint": "8.64.0",
		"vite": "8.1.5",
		"vitest": "4.1.10",
		"workbox-cacheable-response": "7.4.1",
		"workbox-expiration": "7.4.1",
		"workbox-precaching": "7.4.1",
		"workbox-recipes": "7.4.1",
		"workbox-routing": "7.4.1",
		"workbox-strategies": "7.4.1"
	},
	"name": "savvy-frontend",
	"license": "MIT",
	"private": true,
	"scripts": {
		"dev": "vite dev --port 5173",
		"build": "svelte-kit sync && vite build",
		"build:embed": "npm run build && npm run copy:assets",
		"copy:assets": "rm -rf ../internal/assets/client && cp -r build ../internal/assets/client && echo '✅ Assets copied to internal/assets/client/'",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"typecheck": "npm run check",
		"lint": "eslint .",
		"test": "vitest",
		"test:ui": "vitest --ui",
		"test:coverage": "vitest run --coverage",
		"postinstall": "cp node_modules/zxing-wasm/dist/reader/zxing_reader.wasm static/zxing_reader.wasm 2>/dev/null || true",
		"format": "prettier --write './**/*.{svelte,ts,js}'",
		"format:check": "prettier --check './**/*.{svelte,ts,js}'"
	},
	"type": "module",
	"version": "1.0.0"
}
