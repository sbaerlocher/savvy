# Database Configuration
DATABASE_URL=postgres://savvy:savvy_dev_password@localhost:5432/savvy?sslmode=disable

# Server Configuration
ENVIRONMENT=development
SERVER_PORT=3000

# Session Secret (CRITICAL: Change in production!)
# Generate a random 32+ character string for production
SESSION_SECRET=your-secret-key-change-in-production

# Database Migrations (Gormigrate)
# Auto-apply migrations on server startup (recommended: true for development, false for production)
# Set to false in production and run migrations manually via: make migrate-up
AUTO_MIGRATE=true

# Logging Configuration
# Valid values: DEBUG, INFO, WARN, ERROR
# Default: DEBUG in development, INFO in production
# Recommendation: INFO for production, DEBUG for development/troubleshooting
LOG_LEVEL=DEBUG

# OpenTelemetry Configuration (Backend + Frontend)
# Note: OTEL_ENABLED defaults to true in production (ENVIRONMENT=production)
# Set to false explicitly to disable in production (not recommended)
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=otel-collector:4318
OTEL_SERVICE_NAME=savvy
OTEL_SERVICE_VERSION=1.8.0

# Frontend OpenTelemetry (SvelteKit)
# Enable/disable OTEL in the browser (traces, logs, metrics)
VITE_OTEL_ENABLED=false

# Observability Endpoints (automatically available)
# - GET /metrics - Prometheus metrics (HTTP duration, error rate, resource counts, DB stats)
# - GET /health  - Kubernetes liveness probe
# - GET /ready   - Kubernetes readiness probe (checks DB connection)

# OAuth/OIDC Authentication - Optional
# Works with any OIDC provider (Authentik, Keycloak, Auth0, Okta, etc.)
# Leave empty to disable OAuth and use email/password login only
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_ISSUER=https://auth.example.com/application/o/your-app/
OAUTH_REDIRECT_URL=http://localhost:3000/auth/oauth/callback

# OAuth Admin Permissions
# Comma-separated list of email addresses that should have admin privileges
OAUTH_ADMIN_EMAILS=admin@example.com,admin2@example.com
# OIDC group name for admins (e.g., "app-admins")
OAUTH_ADMIN_GROUP=

# OAuth Success Redirect URL
# Where to redirect users after successful OAuth login (SvelteKit frontend URL)
OAUTH_SUCCESS_URL=http://localhost:5173

# Feature Toggles
# Enable/disable specific features (true/false)
# When disabled: routes return 404, navigation links are hidden
# Database data remains unchanged
ENABLE_CARDS=true
ENABLE_VOUCHERS=true
ENABLE_GIFT_CARDS=true

# Authentication Toggles
# Enable/disable authentication methods
ENABLE_LOCAL_LOGIN=true       # Set to false to disable email/password login (OAuth only)
ENABLE_REGISTRATION=true      # Set to false to disable user registration

# Timezone for date calculations (voucher status, etc.)
# IANA timezone (e.g., "Europe/Zurich", "America/New_York", "UTC")
TIMEZONE=UTC

# SMTP Configuration (Email Notifications)
# Required for: Email verification, password reset, expiry reminders
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@example.com
SMTP_FROM_NAME=Savvy
SMTP_USE_TLS=true

# Web Push Notifications (VAPID)
# Generate keys with: npx web-push generate-vapid-keys
# Required for browser push notifications
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@example.com

# Expiry Reminders
# Automated email notifications for expiring vouchers/gift cards
ENABLE_EXPIRY_REMINDERS=true
REMINDER_DAYS_BEFORE=7,3,1           # Days before expiry to send reminders (comma-separated)
REMINDER_CHECK_TIME=08:00            # Daily time to check (HH:MM in configured TIMEZONE)

# Two-Factor Authentication (2FA/TOTP)
# Enable/disable 2FA support (Google Authenticator, Authy, etc.)
ENABLE_2FA=false
TOTP_ISSUER=Savvy                   # Name shown in authenticator apps
TOTP_ENCRYPTION_KEY=                # AES-256 key (32 bytes base64) - CRITICAL: generate and keep secret!
